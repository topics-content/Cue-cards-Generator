OPENROUTER_API_KEY=
# Exact slug from https://openrouter.ai/api/v1/models (do not use the ~latest alias)
LLM_MODEL=anthropic/claude-sonnet-4.6
# Optional: low | medium | high (extended thinking effort). Default medium.
LLM_REASONING_EFFORT=medium
DECK_BUDGET_USD=3
APP_URL=http://localhost:3000
INR_RATE=95
# Comma-separated
ADMIN_EMAILS=
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random string; Vercel sends it as a Bearer token to the cron route
CRON_SECRET=
DECK_BUDGET_STEPS_USD=5
